# FinGuard Orchestrator - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
OPENAI_API_KEY="your_openai_api_key_here"

XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.3

# Runtime behavior. Redis is opt-in and remains experimental.
FINGUARD_CACHE_MODE=memory
FINGUARD_MEMORY_CACHE_MAX_ENTRIES=128
FINGUARD_MODEL_LOCAL_ONLY=0

# Used only when FINGUARD_CACHE_MODE=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
