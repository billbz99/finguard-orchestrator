# FinGuard Orchestrator - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.

# --- Core hosted LLM configuration ---
# XAI_API_KEY is the credential used by FinGuard's application runtime for its
# primary hosted LLM path (src/llm/client.py). Required for the agentic audit
# path and for the API's /ready readiness check.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.3

# --- Evaluation-only configuration ---
# OPENAI_API_KEY is evaluation-only. It is used by the provider-backed
# DeepEval gpt-4o judge in tests/eval_suite.py. It is NOT required by the
# FinGuard application runtime and is not read by any application code path.
OPENAI_API_KEY="your_openai_api_key_here"

# --- Optional cost estimation ---
# Supply verified provider rates in USD per million tokens.
XAI_PRICE_MODEL=
XAI_INPUT_PRICE_PER_MILLION=
XAI_OUTPUT_PRICE_PER_MILLION=
XAI_CACHED_INPUT_PRICE_PER_MILLION=
XAI_PRICING_REVISION=

# --- Optional runtime/cache configuration ---
FINGUARD_CACHE_MODE=memory
FINGUARD_MEMORY_CACHE_MAX_ENTRIES=128
FINGUARD_MODEL_LOCAL_ONLY=0
FINGUARD_CHROMA_PATH=./data/chroma

# --- Optional UI configuration ---
FINGUARD_API_BASE_URL=http://localhost:8000

# --- Optional Redis cache ---
# Redis is opt-in and remains experimental. Used only when
# FINGUARD_CACHE_MODE=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
